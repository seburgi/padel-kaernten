#!/usr/bin/env bash
# Before every push to main (burgstaller-platform standards/workflow/hooks-and-gate.md): the gate, tools/gate.py.
# Pushes to other branches pass through untouched.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

zero=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = refs/heads/main ] || continue
  [ "$local_sha" = "$zero" ] && { echo "✗ main is never deleted."; exit 1; }
  if [ "$local_sha" != "$(git rev-parse HEAD)" ]; then
    echo "✗ Push the commit you have checked out (git push origin HEAD:main): the gate tests HEAD."
    exit 1
  fi
  base="$remote_sha"
  if [ "$base" = "$zero" ] || ! git cat-file -e "$base^{commit}" 2>/dev/null; then
    if git ls-remote --exit-code -q origin refs/heads/main >/dev/null; then
      git fetch -q origin main && base="$(git merge-base HEAD origin/main)"
    else
      # The first push makes main: the gate looks at everything.
      exec python3 tools/gate.py "$(git hash-object -t tree /dev/null)"
    fi
  fi
  if ! git merge-base --is-ancestor "$base" HEAD; then
    echo "✗ main has commits you do not: git pull --rebase origin main, then push again."
    exit 1
  fi
  exec python3 tools/gate.py "$base"
done
