{
  "name": "padel-app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api": "openapi-typescript ../../api/openapi.yaml -o src/api/schema.d.ts && prettier --write src/api/schema.d.ts",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm coverage"
  },
  "dependencies": {
    "@burgstaller/web": "github:seburgi/burgstaller-platform#kit/web/v0.4.2&path:/kit/web",
    "@tanstack/react-query": "^5.90.0",
    "openapi-fetch": "^0.14.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7",
    "globals": "^16",
    "jsdom": "^27.4.0",
    "openapi-typescript": "^7.10.0",
    "playwright": "1.63.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.40.0",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
